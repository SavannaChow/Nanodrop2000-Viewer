<Window x:Class="NanodropViewer.App.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Info"
        Width="900"
        Height="700"
        MinWidth="720"
        MinHeight="560"
        Background="#FFF8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="NanoDrop Interpretation"
                           FontSize="26"
                           FontWeight="Bold" />

                <TextBlock Margin="0,18,0,8"
                           Text="NanoDrop basics"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Text="A260: DNA / RNA absorbance" />
                <TextBlock Text="A280: protein absorbance" />
                <TextBlock Text="A230: salts and extraction carryover" />
                <TextBlock Text="DNA: 260 nm" Margin="0,8,0,0" />
                <TextBlock Text="protein: 280 nm" />
                <TextBlock Text="phenol: 270 nm" />
                <TextBlock Text="guanidine / salt: 230 nm" />
                <TextBlock Text="EDTA: 230 nm" />
                <TextBlock Text="carbohydrate: 230 nm" />

                <TextBlock Margin="0,18,0,8"
                           Text="A260/280 Ratio"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Text="DNA: ~1.8" />
                <TextBlock Text="RNA: ~2.0" />
                <TextBlock Text="Lower values often suggest protein or phenol contamination." TextWrapping="Wrap" />

                <TextBlock Margin="0,18,0,8"
                           Text="A260/230 Ratio"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Text="DNA / RNA: ~2.0 to 2.2" />
                <TextBlock Text="Lower values often suggest guanidine, EDTA, carbohydrates, or other extraction carryover." TextWrapping="Wrap" />

                <Border Margin="0,18,0,0"
                        Padding="12"
                        Background="#FFFFFFFF"
                        BorderBrush="#FFD0D7E2"
                        BorderThickness="1"
                        CornerRadius="12">
                    <TextBlock Text="Compare the sample curve shape with the contaminant reference overlays before concluding purity."
                               TextWrapping="Wrap" />
                </Border>

                <Image Margin="0,16,0,0"
                       Stretch="Uniform"
                       Source="Resources/contaminants_cause.jpg" />
                <Image Margin="0,16,0,0"
                       Stretch="Uniform"
                       Source="Resources/uv_absorbance_spectra_common_contaminant_with_dna.jpg" />
                <Image Margin="0,16,0,0"
                       Stretch="Uniform"
                       Source="Resources/uv_absorbance_spectra_of_phenol_and_trizol_mixed_with_rna.jpg" />
                <Image Margin="0,16,0,0"
                       Stretch="Uniform"
                       Source="Resources/spectra_of_contaminated_dna.webp" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Close"
                    Padding="16,8"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
