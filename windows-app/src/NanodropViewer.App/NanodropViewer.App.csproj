<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>NanodropViewer.App</AssemblyName>
    <RootNamespace>NanodropViewer.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NanodropViewer.Core\NanodropViewer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\reference_spectra\*.jdx" LogicalName="ReferenceSpectra.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\..\Sources\NanodropViewerMac\Resources\contaminants_cause.jpg" Link="Resources\contaminants_cause.jpg" />
    <Resource Include="..\..\..\Sources\NanodropViewerMac\Resources\uv_absorbance_spectra_common_contaminant_with_dna.jpg" Link="Resources\uv_absorbance_spectra_common_contaminant_with_dna.jpg" />
    <Resource Include="..\..\..\Sources\NanodropViewerMac\Resources\uv_absorbance_spectra_of_phenol_and_trizol_mixed_with_rna.jpg" Link="Resources\uv_absorbance_spectra_of_phenol_and_trizol_mixed_with_rna.jpg" />
    <Resource Include="..\..\..\Sources\NanodropViewerMac\Resources\spectra_of_contaminated_dna.webp" Link="Resources\spectra_of_contaminated_dna.webp" />
  </ItemGroup>
</Project>
