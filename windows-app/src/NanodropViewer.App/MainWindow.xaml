<Window x:Class="NanodropViewer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NanodropViewer.App"
        Title="nanodrop 2000 viewer"
        Width="1440"
        Height="900"
        MinWidth="900"
        MinHeight="600"
        Background="#FFF5F7FB">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="20" Padding="16">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Import" Margin="0,0,8,0" Padding="14,8" Command="{Binding ImportCommand}" />
                        <Button Content="Export" Padding="14,8" Command="{Binding ExportCommand}" />
                    </StackPanel>
                    <TextBlock Margin="0,12,0,0"
                               Text="{Binding FileName}"
                               TextWrapping="Wrap"
                               Foreground="#FF4E5B75" />
                    <TextBlock Margin="0,8,0,0"
                               Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               Foreground="#FF667085" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Previous" Margin="0,0,8,0" Padding="14,8" Command="{Binding PreviousCommand}" />
                        <Button Content="Next" Padding="14,8" Command="{Binding NextCommand}" />
                    </StackPanel>
                </StackPanel>

                <ListBox ItemsSource="{Binding Samples}"
                         SelectedItem="{Binding SelectedSample}"
                         DisplayMemberPath="DisplayName"
                         Margin="0,12,0,12" />
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#FFD0D7E2"
                      Width="6" />

        <Border Grid.Column="2" Background="White" CornerRadius="20" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ItemsControl Grid.Row="0" ItemsSource="{Binding SummaryItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4"
                                    Padding="10,8"
                                    BorderBrush="#FFD0D7E2"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" Foreground="#FF667085" FontSize="11" />
                                    <TextBlock Text="{Binding Value}" FontWeight="SemiBold" FontSize="13" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="1"
                        Padding="12"
                        BorderBrush="#FFD0D7E2"
                        BorderThickness="1"
                        CornerRadius="12"
                        Background="#FFF8FAFC"
                        Margin="4,8,4,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Normalization"
                                       VerticalAlignment="Center"
                                       Foreground="#FF667085"
                                       Margin="0,0,12,0" />
                            <ComboBox Width="180"
                                      SelectedItem="{Binding SelectedNormalizationMode}"
                                      ItemsSource="{Binding NormalizationModes}" />
                        </StackPanel>

                        <TextBlock Text="Reference spectra"
                                   Margin="0,12,0,8"
                                   FontWeight="SemiBold" />

                        <ItemsControl ItemsSource="{Binding ReferenceOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Top"
                                                  Margin="0,2,8,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding ShortTitle}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding FullTitle}"
                                                       Foreground="#FF667085"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" BorderBrush="#FFD0D7E2" BorderThickness="1" CornerRadius="16" Background="#FFF8FAFC">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ItemsControl Grid.Row="0" ItemsSource="{Binding OverlayPreviewItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,8,8"
                                            Padding="10,8"
                                            BorderBrush="#FFD0D7E2"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Background="White">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ShortTitle}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding PeakWavelength}" Foreground="#FF667085" />
                                            <TextBlock Text="{Binding PeakValue}" Foreground="#FF667085" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Grid.Row="1">
                            <local:SpectrumPlotControl Series="{Binding PlotSeries}" />
                            <TextBlock Text="{Binding PlotPlaceholderText}"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#FF667085"
                                       FontSize="18"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlotSeries.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
